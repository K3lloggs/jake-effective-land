# Copy these lines into your .env file (keep your APIFY_TOKEN line) and fill them in.
APIFY_TOKEN=

# Outgoing email. For Gmail or Google Workspace: turn on 2-step verification, create an "app password",
# and use it as SMTP_PASS. Any other provider's SMTP settings work the same way.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=
FROM_NAME=Your Name or Company
FROM_EMAIL=you@yourdomain.com
# A real mailing address is legally required in the footer of commercial email. A PO box is fine.
POSTAL_ADDRESS=123 Example St, Philadelphia, PA 19125
EMAIL_DAILY_CAP=40
